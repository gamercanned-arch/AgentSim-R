# -------------------------
# API keys (Add as many as you want!)
# The engine will cycle through GEMINI_API_KEY_1 ... GEMINI_API_KEY_N
# -------------------------
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=

# -------------------------
# Models (JSON list OR comma-separated)
# If left blank, defaults to the first model in `models_list`.
# -------------------------
GEMINI_MODELS=["gemini-2.5-flash"]

# Fallback model slots (used only if *_MODELS not set)
GEMINI_MODEL_1=gemini-2.5-flash

# -------------------------
# Summarizer configuration
# -------------------------
SUMMARY_PROVIDER=gemini
SUMMARY_MODEL=gemini-2.5-flash
SUMMARY_MAX_TOKENS=2048

# -------------------------
# Generation settings
# -------------------------
LLM_TEMPERATURE=0.7
LLM_TOP_P=0.9
API_MAX_NEW_TOKENS=16384

# Rough context target (API runner)
API_CONTEXT_SIZE=1000000
API_CONTEXT_FILL_RATIO=0.80

# -------------------------
# Autosave
# -------------------------
AUTOSAVE_TICKS=10

# Summarizer prompt customization (optional)
SUMMARY_USER_PROMPT_PATH=prompts/summary_user.txt
SUMMARY_USER_PROMPT=
SUMMARY_SYSTEM_PROMPT=