# -------------------------
# API keys (up to 5 each)
# -------------------------
OPENROUTER_API_KEY_1=
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=
OPENROUTER_API_KEY_4=
OPENROUTER_API_KEY_5=

GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=

CEREBRAS_API_KEY_1=
CEREBRAS_API_KEY_2=
CEREBRAS_API_KEY_3=
CEREBRAS_API_KEY_4=
CEREBRAS_API_KEY_5=

# -------------------------
# Models (preferred: lists)
# - JSON list OR comma/newline-separated
# -------------------------
OPENROUTER_MODELS=["openai/gpt-5.2"]
GROQ_MODELS=["openai/gpt-oss-120b"]
CEREBRAS_MODELS=["qwen-3-235b-a22b-instruct-2507"]

# Fallback model slots (used only if *_MODELS not set)
OPENROUTER_MODEL_1=openai/gpt-5.2
GROQ_MODEL_1=openai/gpt-oss-120b
CEREBRAS_MODEL_1=qwen-3-235b-a22b-instruct-2507

# -------------------------
# Summarizer configuration
# -------------------------
SUMMARY_PROVIDER=openrouter
SUMMARY_MODEL=openai/gpt-5.2
SUMMARY_MAX_TOKENS=2048

# -------------------------
# Generation settings
# -------------------------
TEMP=0.7
TOP_P=0.9
API_MAX_NEW_TOKENS=16384

# Rough context target (API runner)
API_CONTEXT_SIZE=100000
API_CONTEXT_FILL_RATIO=0.80

# Tool-role handling: tool | user_wrapped | auto
TOOL_ROLE_MODE=auto

# Autosave every N ticks (both runners)
AUTOSAVE_TICKS=10

# Optional OpenRouter ranking headers
OPENROUTER_HTTP_REFERER=
OPENROUTER_TITLE=

# Summarizer prompt customization (optional)
# Prefer using a file:
SUMMARY_USER_PROMPT_PATH=prompts/summary_user.txt

# Or inline (must include {existing_summary} and {chunk_text}):
SUMMARY_USER_PROMPT=

# Optional override for summarizer system prompt:
SUMMARY_SYSTEM_PROMPT=